@page "/"
@using System.Text.Json
@using Piratenet.Models
@inject IJSRuntime JS
@inject LanguageState LanguageState

<PageTitle>Piratenet - Planos dorados de sistemas</PageTitle>

<div class="blueprint-container">
    <table class="blueprint-table blueprint-table-compact">
        <thead>
            <tr>
                @for (var systemIndex = 0; systemIndex < SystemIds.Length; systemIndex++)
                {
                    @if (systemIndex == 0)
                    {
                        <th></th>
                        <th>@BlueprintCatalog.GetSystemName(SystemIds[systemIndex], LanguageState.CurrentLanguage)</th>
                    }
                    else
                    {
                        <th>@BlueprintCatalog.GetSystemName(SystemIds[systemIndex], LanguageState.CurrentLanguage)</th>
                    }
                }
            </tr>
        </thead>
        <tbody>
            @for (var rowIndex = 0; rowIndex < BlueprintRows.Length; rowIndex++)
            {
                var row = BlueprintRows[rowIndex];
                var isSectionStart = rowIndex > 0 && row.Color != BlueprintRows[rowIndex - 1].Color;
                <tr class="@(isSectionStart ? "blueprint-section-start" : null)">
                    @for (var systemIndex = 0; systemIndex < SystemIds.Length; systemIndex++)
                    {
                        var availabilityIndex = GetAvailabilityIndex(systemIndex);
                        var status = row.Availability[availabilityIndex];
                        if (status.HasValue)
                        {
                            var clickedRowIndex = rowIndex;
                            var clickedSystemIndex = systemIndex;

                            @if (systemIndex == 0)
                            {
                                <td class="blueprint-item" style="background-color:@row.Color">@BlueprintCatalog.GetPlanName(row.Id, LanguageState.CurrentLanguage)</td>
                            }
                            <td class="blueprint-status @(status.Value ? "available" : "missing")"
                                @onclick="() => ToggleAvailability(clickedRowIndex, clickedSystemIndex)"
                                title="Haz clic para alternar">
                                @((status.Value) ? "Y" : "N")
                            </td>
                        }
                        else
                        {
                            @if (systemIndex == 0)
                            {
                                <td class="blueprint-item" style="background-color:@row.Color">@BlueprintCatalog.GetPlanName(row.Id, LanguageState.CurrentLanguage)</td>
                            }
                            <td class="blueprint-placeholder"></td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private readonly string[] SystemIds = BlueprintCatalog.GoldDisplaySystems;

    private BlueprintRow[] BlueprintRows =
    {
        new("blaster", "#ffffff", true, true, true, true, true, true),
        new("collector", "#ffffff", true, true, true, true, true, true),
        new("repairer", "#ffffff", true, true, true, true, true, true),
        new("booster", "#ffffff", true, true, true, true, true, true),

        new("missiles", "#d98880", true, true, true, true, true, true),
        new("computer_sight", "#d98880", true, true, true, true, true, true),
        new("driller", "#d98880", null, true, true, true, true, true),
        new("thermal_ray", "#d98880", null, null, true, true, true, true),

        new("shield", "#f9e79f", true, true, true, true, true, true),
        new("miner", "#f9e79f", true, true, true, true, true, true),
        new("interference_signal", "#f9e79f", null, true, true, true, true, true),
        new("aggression_bomb", "#f9e79f", null, null, true, true, true, true),

        new("accelerator", "#85c1e9", true, true, true, true, true, true),
        new("decelerator", "#85c1e9", true, true, true, true, true, true),
        new("decoy", "#85c1e9", null, true, true, true, true, true),
        new("paralyzer", "#85c1e9", null, null, true, true, true, true),

        new("protector", "#a9dfbf", true, true, true, true, true, true),
        new("tele_repairer", "#a9dfbf", true, true, true, true, true, true),
        new("repair_field", "#a9dfbf", null, true, true, true, true, true),
        new("resurrector", "#a9dfbf", null, null, true, true, true, true),

        new("long_range", "#eb984e", null, null, null, true, true, true),
        new("attack_drone", "#eb984e", null, null, null, true, true, true),
        new("orbital", "#eb984e", null, null, null, true, true, true),
        new("attack_cargo", "#eb984e", null, null, null, true, true, true),

        new("attack_tower", "#bb8fce", null, null, null, true, true, false),
        new("repair_tower", "#bb8fce", null, null, null, true, true, false),
        new("mine", "#bb8fce", null, null, null, true, true, false),
        new("lapa_bomb", "#bb8fce", null, null, null, true, true, false),

        new("absorber", "#a6b0b7", null, null, null, true, true, true),
        new("inverter", "#a6b0b7", null, null, null, true, true, true),
        new("trap", "#a6b0b7", null, null, null, true, true, true),
        new("jump", "#a6b0b7", null, null, null, true, true, true),
        new("cloud", "#a6b0b7", null, null, null, true, true, true),
        new("deflector", "#a6b0b7", null, null, null, true, true, true),
        new("aura", "#a6b0b7", null, null, null, true, true, true),
        new("electric_beam", "#a6b0b7", null, null, null, true, true, true),
    };

    private int GetAvailabilityIndex(int displayedSystemIndex)
    {
        return SystemIds.Length - 1 - displayedSystemIndex;
    }

    private string GetStoredSystemId(int availabilityIndex)
    {
        return SystemIds[SystemIds.Length - 1 - availabilityIndex];
    }

    private const string StorageKey = "piratenet.blueprints.v3";
    private const string LegacyStorageKey = "piratenet.blueprints.v2";

    /// <summary>
    /// Carga los estados persistidos despues del primer renderizado interactivo.
    /// Se ejecuta una sola vez para evitar sobrescribir cambios posteriores del usuario.
    /// </summary>
    /// <param name="firstRender">Indica si es el primer renderizado del componente.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LanguageState.LoadAsync(JS);
            await LoadStateAsync();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Recupera desde localStorage el estado de la tabla de planos dorados.
    /// Los datos solo se aplican si conservan la misma forma que la configuracion actual.
    /// </summary>
    private async Task LoadStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", StorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                json = await JS.InvokeAsync<string>("localStorage.getItem", LegacyStorageKey);
                if (string.IsNullOrWhiteSpace(json))
                {
                    return;
                }

                var legacy = JsonSerializer.Deserialize<bool?[][]>(json);
                if (legacy is null || legacy.Length != BlueprintRows.Length)
                {
                    return;
                }

                for (var rowIndex = 0; rowIndex < BlueprintRows.Length; rowIndex++)
                {
                    for (var availabilityIndex = 0; availabilityIndex < SystemIds.Length; availabilityIndex++)
                    {
                        if (legacy[rowIndex] is not null && availabilityIndex < legacy[rowIndex].Length)
                        {
                            BlueprintRows[rowIndex].Availability[availabilityIndex] = legacy[rowIndex][availabilityIndex];
                        }
                    }
                }

                await SaveStateAsync();
                return;
            }

            var stored = JsonSerializer.Deserialize<StoredBooleanValues>(json);
            if (stored?.Values is null)
            {
                return;
            }

            for (var rowIndex = 0; rowIndex < BlueprintRows.Length; rowIndex++)
            {
                for (var availabilityIndex = 0; availabilityIndex < SystemIds.Length; availabilityIndex++)
                {
                    var configuredValue = BlueprintRows[rowIndex].Availability[availabilityIndex];
                    var key = BlueprintCatalog.GoldKey(GetStoredSystemId(availabilityIndex), BlueprintRows[rowIndex].Id);
                    BlueprintRows[rowIndex].Availability[availabilityIndex] = configuredValue.HasValue && stored.Values.TryGetValue(key, out var value)
                        ? value
                        : null;
                }
            }
        }
        catch
        {
            // Ignored: LocalStorage puede no estar disponible.
        }
    }

    /// <summary>
    /// Serializa y guarda en localStorage el estado actual de los planos dorados.
    /// </summary>
    private async Task SaveStateAsync()
    {
        try
        {
            var values = new Dictionary<string, bool?>();
            for (var rowIndex = 0; rowIndex < BlueprintRows.Length; rowIndex++)
            {
                for (var availabilityIndex = 0; availabilityIndex < SystemIds.Length; availabilityIndex++)
                {
                    values[BlueprintCatalog.GoldKey(GetStoredSystemId(availabilityIndex), BlueprintRows[rowIndex].Id)] = BlueprintRows[rowIndex].Availability[availabilityIndex];
                }
            }

            var json = JsonSerializer.Serialize(new StoredBooleanValues(3, values));
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
        }
        catch
        {
            // Ignored: LocalStorage puede no estar disponible.
        }
    }

    /// <summary>
    /// Alterna entre disponible y pendiente una celda existente de la tabla dorada.
    /// Las celdas inexistentes no se modifican.
    /// </summary>
    /// <param name="rowIndex">Indice de la fila del plano.</param>
    /// <param name="systemIndex">Indice del sistema al que pertenece la celda.</param>
    private async Task ToggleAvailability(int rowIndex, int systemIndex)
    {
        var availabilityIndex = GetAvailabilityIndex(systemIndex);
        var current = BlueprintRows[rowIndex].Availability[availabilityIndex];
        if (current.HasValue)
        {
            BlueprintRows[rowIndex].Availability[availabilityIndex] = !current.Value;
            await SaveStateAsync();
        }
    }

    private sealed record BlueprintRow(string Id, string Color, params bool?[] Availability);

    private sealed record StoredBooleanValues(int Version, Dictionary<string, bool?> Values);
}
