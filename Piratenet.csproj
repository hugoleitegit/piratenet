<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- Replace base href in the PUBLISHED wwwroot/index.html only (do not edit source file). -->
  <Target Name="SetBaseHrefForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <!-- Default to root for development; override with -p:BaseHref=/your/path/ when publishing -->
      <BaseHref Condition="'$(BaseHref)'==''">/</BaseHref>
      <PublishedIndexHtml>$(PublishDir)wwwroot\index.html</PublishedIndexHtml>
    </PropertyGroup>
    <Message Importance="High" Text="Setting base href to '$(BaseHref)' in $(PublishedIndexHtml)" />
    <Exec Command="powershell -NoProfile -Command &quot;if (Test-Path '$(PublishedIndexHtml)') { (Get-Content '$(PublishedIndexHtml)') -replace '<base\s+href=(?:&quot;[^&quot;]*&quot;|[^\s>]+)\s*/?>', '&lt;base href=&quot;$(BaseHref)&quot; /&gt;' | Set-Content '$(PublishedIndexHtml)' } else { Write-Host 'Published index not found: $(PublishedIndexHtml)' }&quot;" />
  </Target>

</Project>
