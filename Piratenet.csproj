<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- Replace base href in wwwroot/index.html when publishing. -->
  <Target Name="SetBaseHrefForPublish" BeforeTargets="PrepareForPublish">
    <PropertyGroup>
      <!-- Default to root for development; override with -p:BaseHref=/your/path/ when publishing -->
      <BaseHref Condition="'$(BaseHref)'==''">/</BaseHref>
      <IndexHtml>$(ProjectDir)wwwroot\index.html</IndexHtml>
    </PropertyGroup>
    <Message Importance="High" Text="Setting base href to '$(BaseHref)' in $(IndexHtml)" />
      <Exec Command="powershell -NoProfile -Command &quot;(Get-Content '$(IndexHtml)') -replace '&lt;base href=&quot;.*?&quot;\s*/&gt;', '&lt;base href=&quot;$(BaseHref)&quot; /&gt;' | Set-Content '$(IndexHtml)'&quot;" />
  </Target>

</Project>
